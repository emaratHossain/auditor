# Dependencies — reinstalled inside the image by composer install / npm ci.
# These were built on macOS; the Playwright and esbuild binaries in them are
# Darwin builds and cannot run on Linux.
node_modules
vendor

# Build output — regenerated by `npm run build`. A stale copy is worse than none.
public/build
public/hot
public/storage

# Secrets. Never bake these into an image layer.
.env
.env.*
!.env.example
.env.backup
.env.production
auth.json
storage/*.key

# Google session cookies from the GA4 capture profile.
storage/app/browser-profile

# Git history — 34 MB, and the container never reads it.
.git
.gitignore
.gitattributes

# Laravel runtime state. The `/*` keeps the folder, drops the contents,
# so the app can still write into it.
storage/logs/*
storage/pail/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/app/pdf/*
storage/app/private/*
storage/app/public/screenshots/*
storage.zip

# Local database files.
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite-shm
database/*.sqlite-wal

# Tests and their output — the image runs with composer --no-dev.
tests
test-results
playwright-report
playwright.config.js
phpunit.xml
.phpunit.cache
.phpunit.result.cache
.playwright-mcp

# Docs, board and slides — source of truth for humans, dead weight in the image.
doc
docs
deck
kanban
README.md
CLAUDE.md

# Deploy packaging, rebuilt on demand.
deploy/*.zip

# Docker's own files — changing them should not invalidate the app layers.
Dockerfile
docker-compose.yml
.dockerignore
nginx

# Editor and OS noise.
.claude
.idea
.vscode
.fleet
.nova
.zed
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml
.phpactor.json

# Stray screenshots left in the project root.
*.png
npm-debug.log
yarn-error.log
*.log
