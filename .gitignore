# Local browser profile used for GA4 documentation capture — contains a Google session
/storage/app/browser-profile

# Laravel's own runtime state — regenerated on demand, never source.
# The empty folders stay tracked via .gitkeep, because Laravel needs them to exist:
# config view.compiled is realpath(storage/framework/views), and realpath() returns
# false on a missing folder, which makes `artisan view:clear` fail.
/storage/app/private/*
!/storage/app/private/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/data
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Audit output. Screenshots 1–5 and audit-3.* are committed demo fixtures and stay
# tracked; everything a real run writes here is disposable.
/storage/app/pdf
/storage/app/public/screenshots

# Local SQLite database — schema lives in database/migrations, data does not
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# Browser-automation scratch output (Playwright MCP traces, one-off debug screenshots)
/.playwright-mcp

# One-off screenshots dropped in the project root while checking a screen
# (prefill-form.png, confirm-390.png, pages-390.png, pages-desktop.png).
# Real image assets live under resources/ or public/ and are unaffected.
/*.png

# cPanel upload package — rebuilt on demand, not source.
# dropsense-cpanel/ is a second full copy of the app, generated by the packer.
/deploy/*.zip
/deploy/dropsense-cpanel/

# Ad-hoc archive of the storage folder. Runtime output, not source.
/storage.zip

# Slides are rebuilt from deck/build_deck.py; the .pptx files are output.
/deck/*

# Per-developer Claude Code settings. The skills in .claude/skills/ stay tracked.
.claude/settings.local.json
